---
import KbSearch from './KbSearch.astro';
import { kbCopy, kbSupportPath, type KbLocale } from '@/lib/kb';

interface Props {
  locale: KbLocale;
  title?: string;
  description?: string;
  compact?: boolean;
  showPreviewNotice?: boolean;
}

const {
  locale,
  title = kbCopy[locale].siteTitle,
  description = kbCopy[locale].siteDescription,
  compact = false,
  showPreviewNotice = true,
} = Astro.props;
const copy = kbCopy[locale];
---

<section class:list={['relative overflow-hidden border-b border-[#cfe9e9] bg-[#edf9f8]', compact ? 'py-9 md:py-12' : 'py-12 md:py-18']}>
  <div class="pointer-events-none absolute -right-28 -top-32 size-96 rounded-full bg-[#39c6c8]/10 blur-2xl"></div>
  <div class="pointer-events-none absolute -bottom-40 -left-24 size-80 rounded-full bg-[#173f56]/5 blur-3xl"></div>
  <div class="container relative max-w-5xl text-center">
    {showPreviewNotice && (
      <div class="mb-6 inline-flex max-w-full items-center gap-2 rounded-full border border-[#9ddcdb] bg-white/80 px-4 py-2 text-left text-xs font-semibold text-[#165566] shadow-sm">
        <span class="inline-flex shrink-0 rounded-full bg-[#173f56] px-2 py-0.5 text-[10px] uppercase tracking-[0.12em] text-white">{copy.previewLabel}</span>
        <span>{copy.previewNotice}</span>
      </div>
    )}
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-[#0f6f76]">BioSked Support</p>
    <h1 class:list={['mx-auto max-w-4xl font-heading font-semibold tracking-[-0.035em] text-[#102f46]', compact ? 'text-3xl md:text-4xl' : 'text-4xl md:text-6xl']}>
      {title}
    </h1>
    <p class:list={['mx-auto mt-4 max-w-2xl leading-relaxed text-slate-600', compact ? 'text-base' : 'text-lg']}>
      {description}
    </p>
    <div class="mt-8">
      <KbSearch locale={locale} compact={compact} />
    </div>
    {!compact && (
      <a href={kbSupportPath(locale)} class="mt-5 inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold text-[#13596a] transition hover:bg-white/70 hover:text-[#102f46]">
        {copy.support}
        <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
</section>
