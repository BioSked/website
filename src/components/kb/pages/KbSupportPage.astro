---
import BaseLayout from '@/layouts/BaseLayout.astro';
import KbHero from '@/components/kb/KbHero.astro';
import KbSupportForm from '@/components/kb/KbSupportForm.astro';
import {
  kbCopy,
  kbHomePath,
  kbSupportPath,
  languageLinks,
  type KbLocale,
} from '@/lib/kb';

interface Props {
  locale: KbLocale;
}

const { locale } = Astro.props;
const copy = kbCopy[locale];
// The support page exists in every knowledge base locale.
const languages = languageLinks(locale).map((language) => ({ ...language, href: kbSupportPath(language.code) }));
const localeAlternates = Object.fromEntries(languages.map((language) => [language.code, language.href]));
---

<BaseLayout
  title={`${copy.supportFormTitle} | BioSked`}
  description={copy.supportFormDescription}
  locale={locale}
  languageLinks={languages}
  localeAlternates={localeAlternates}
  canonicalUrl={kbSupportPath(locale)}
  pageType="knowledge-base-support"
>
  <KbHero
    locale={locale}
    title={copy.supportFormTitle}
    description={copy.supportFormDescription}
    compact={true}
  />

  <section class="py-12 md:py-18">
    <div class="container max-w-5xl">
      <nav aria-label="Breadcrumb" class="mb-7 text-sm text-slate-500">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={kbHomePath(locale)} class="font-medium text-[#137b83] hover:underline">{copy.backToHome}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-slate-700">{copy.support}</li>
        </ol>
      </nav>
      <div class="mx-auto max-w-2xl">
        <KbSupportForm locale={locale} />
      </div>
    </div>
  </section>
</BaseLayout>
