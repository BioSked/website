---
import type { KbArticle, KbLocale } from '@/lib/kb';
import { formatKbDate, kbCopy } from '@/lib/kb';

interface Props {
  article: KbArticle;
  locale: KbLocale;
  compact?: boolean;
}

const { article, locale, compact = false } = Astro.props;
const copy = kbCopy[locale];
const updated = formatKbDate(article.lastModified, locale);
---

<a href={`${article.sitePath}/`} class:list={[
  'group flex h-full min-w-0 flex-col rounded-2xl border border-slate-200 bg-white transition duration-200 hover:-translate-y-0.5 hover:border-[#78d4d4] hover:shadow-[0_20px_50px_-34px_rgba(15,54,71,0.65)]',
  compact ? 'p-5' : 'p-6',
]}>
  <div class="mb-4 flex min-w-0 items-center gap-2 text-xs font-semibold uppercase tracking-[0.09em] text-[#0f6f76]">
    <span>{article.primaryCategory?.title ?? copy.siteTitle}</span>
    {article.subcategory && <><span class="text-slate-300">/</span><span class="truncate text-slate-500">{article.subcategory}</span></>}
  </div>
  <h3 class="font-heading text-lg font-semibold leading-snug text-[#102f46] transition group-hover:text-[#137b83]">{article.title}</h3>
  {!compact && <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-slate-600">{article.description}</p>}
  <div class="mt-auto flex items-center justify-between gap-4 pt-5 text-xs text-slate-500">
    <span>{updated ? `${copy.articleUpdated} ${updated}` : copy.sourceLabel}</span>
    <span aria-hidden="true" class="text-lg text-[#15979b] transition-transform group-hover:translate-x-1">→</span>
  </div>
</a>
