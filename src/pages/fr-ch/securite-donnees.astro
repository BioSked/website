---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import Card from "@/components/ui/Card.astro";
import Button from "@/components/ui/Button.astro";

const points = [
  {
    title: "LPD suisse et champ du RGPD",
    text: "La loi fédérale sur la protection des données (LPD) encadre les traitements relevant du droit suisse. Le RGPD peut aussi s'appliquer selon les personnes et activités concernées; le DPA consigne les engagements retenus pour chaque client.",
  },
  {
    title: "Rôles entre l'organisation et BioSked",
    text: "L'organisation suisse décide de l'utilisation des données de planning de ses équipes. Elle en est généralement le responsable du traitement, tandis que Bio-Optronics Sàrl les traite selon ses instructions contractuelles.",
  },
  {
    title: "Hébergement européen pour les clients suisses",
    text: "Les environnements Momentum des clients suisses sont hébergés en Europe. Les accès transfrontaliers nécessaires au support ou à un prestataire sont encadrés par les garanties décrites dans la politique de confidentialité et les documents contractuels.",
  },
  {
    title: "Accès, rectification et autorité fédérale",
    text: "Une personne peut adresser sa demande à son organisation lorsqu'elle contrôle les données Momentum, ou au DPO de BioSked pour les traitements dont BioSked est responsable. Elle peut également contacter le PFPDT.",
  },
  {
    title: "Mesures techniques et administratives",
    text: "Momentum chiffre les échanges par TLS et les données au repos. Les administrateurs du client attribuent les droits par rôle et privilège; les opérations de planning et les demandes restent traçables dans l'application.",
  },
  {
    title: "Un périmètre non clinique",
    text: "La plateforme traite les informations professionnelles utiles aux horaires, affectations, gardes et absences. Elle ne stocke pas de dossier patient, ne produit pas de score individuel et ne déduit pas l'état de santé ou le comportement d'un collaborateur.",
  },
];
---

<BaseLayout
  title="Sécurité & données en Suisse | BioSked Momentum"
  description="Protection des données Momentum en Suisse : LPD, rôles contractuels, hébergement européen, flux transfrontaliers, chiffrement et recours auprès du PFPDT."
>
  <section class="section-padding">
    <div class="container max-w-4xl">
      <p class="font-mono text-sm font-semibold uppercase tracking-widest text-muted-foreground">Suisse | Sécurité &amp; données</p>
      <h1 class="text-display-hero mt-4">Des garanties adaptées aux organisations suisses</h1>
      <p class="text-lead text-muted-foreground mt-5 max-w-2xl">
        Pour les clients de Suisse romande, Momentum articule les exigences de la LPD avec les
        engagements contractuels, l'hébergement européen et les contrôles nécessaires à un service
        de planification fiable.
      </p>
    </div>
  </section>
  <section class="section-padding pt-0">
    <div class="container max-w-5xl">
      <div class="grid gap-4 sm:grid-cols-2">
        {points.map((pt) => (
          <Card className="p-6 bg-white/15">
            <h2 class="font-semibold text-foreground mb-2">{pt.title}</h2>
            <p class="text-muted-foreground text-sm">{pt.text}</p>
          </Card>
        ))}
      </div>
      <p class="text-muted-foreground text-sm mt-8">
        Pour exercer un droit ou interroger le DPO : <a href="mailto:dpo@biosked.com" class="text-accent hover:underline">dpo@biosked.com</a> ·
        Consulter les <a href="/fr-ch/mentions-legales/" class="text-accent hover:underline">mentions légales suisses</a> et la
        <a href="/privacy/" class="text-accent hover:underline">politique de confidentialité</a>.
      </p>
      <div class="mt-10">
        <a href="/fr-ch/demo/">
          <Button size="lg" className="rounded-full px-5 font-bold">Demander une démo</Button>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
