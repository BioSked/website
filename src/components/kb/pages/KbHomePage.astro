---
import BaseLayout from '@/layouts/BaseLayout.astro';
import KbHero from '@/components/kb/KbHero.astro';
import KbArticleCard from '@/components/kb/KbArticleCard.astro';
import {
  articlesFor,
  categoriesFor,
  kbCopy,
  kbHomePath,
  kbSupportPath,
  languageLinks,
  latestArticles,
  type KbLocale,
} from '@/lib/kb';

interface Props {
  locale: KbLocale;
}

const { locale } = Astro.props;
const copy = kbCopy[locale];
const categories = categoriesFor(locale);
const articles = articlesFor(locale);
const latest = latestArticles(locale, 6);
// Every knowledge base locale has a home page, so all of them are true alternates.
const languages = languageLinks(locale);
const localeAlternates = Object.fromEntries(languages.map((language) => [language.code, language.href]));
---

<BaseLayout
  title={`${copy.siteTitle} | BioSked`}
  description={copy.siteDescription}
  locale={locale}
  languageLinks={languages}
  localeAlternates={localeAlternates}
  canonicalUrl={kbHomePath(locale)}
  pageType="knowledge-base"
>
  <KbHero locale={locale} />

  <section class="py-14 md:py-20">
    <div class="container max-w-5xl">
      <div class="mb-8 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#0f6f76]">{articles.length} {copy.categoryCount(articles.length).replace(/^\d+\s*/, '')}</p>
          <h2 class="mt-2 font-heading text-3xl font-semibold tracking-[-0.025em] text-[#102f46]">{copy.categoriesTitle}</h2>
        </div>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        {categories.map((category, index) => (
          <a data-kb-category-card href={`${category.sitePath}/`} class="group relative overflow-hidden rounded-3xl border border-slate-200 bg-white p-7 transition duration-200 hover:-translate-y-0.5 hover:border-[#70d2d2] hover:shadow-[0_24px_55px_-40px_rgba(15,54,71,0.7)]">
            <div class="flex items-start justify-between gap-5">
              <div>
                <span class="inline-flex size-10 items-center justify-center rounded-xl bg-[#e6f8f7] text-lg font-bold text-[#0f6f76]" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <h3 class="mt-5 font-heading text-xl font-semibold text-[#102f46] transition group-hover:text-[#137b83]">{category.title}</h3>
                <p class="mt-2 text-sm text-slate-500">{copy.categoryCount(category.articlePaths.length)}</p>
              </div>
              <span aria-hidden="true" class="mt-2 text-2xl text-[#15979b] transition-transform group-hover:translate-x-1">→</span>
            </div>
            {category.subcategories.length > 0 && (
              <div class="mt-5 flex flex-wrap gap-2">
                {category.subcategories.slice(0, 4).map((subcategory) => (
                  <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">{subcategory}</span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-[#f7fafb] py-14 md:py-20">
    <div class="container max-w-5xl">
      <div class="mb-8 flex items-center justify-between gap-4">
        <h2 class="font-heading text-3xl font-semibold tracking-[-0.025em] text-[#102f46]">{copy.latestTitle}</h2>
      </div>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {latest.map((article) => <KbArticleCard article={article} locale={locale} />)}
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20">
    <div class="container max-w-5xl">
      <div class="relative overflow-hidden rounded-3xl bg-[#102f46] px-7 py-10 text-white md:flex md:items-center md:justify-between md:gap-10 md:px-12">
        <div class="pointer-events-none absolute -right-20 -top-28 size-72 rounded-full bg-[#35c7c9]/20 blur-2xl"></div>
        <div class="relative max-w-2xl">
          <h2 class="font-heading text-3xl font-semibold">{copy.supportTitle}</h2>
          <p class="mt-3 leading-relaxed text-white/75">{copy.supportDescription}</p>
        </div>
        <a href={kbSupportPath(locale)} class="relative mt-7 inline-flex shrink-0 items-center justify-center rounded-full bg-[#48c9ca] px-6 py-3 font-bold text-[#082f3e] transition hover:bg-[#6bd5d5] md:mt-0">{copy.support}</a>
      </div>
    </div>
  </section>
</BaseLayout>
