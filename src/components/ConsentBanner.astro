---
import { splitLocale } from '@/i18n/locales';
import { toSwissGerman } from '@/i18n/swissGerman';

/**
 * First-layer audience-measurement choice. BaseHead shows it automatically only
 * where prior consent is required; persistent desktop and mobile controls can
 * reopen it everywhere.
 */
const { locale } = splitLocale(Astro.url.pathname);
type ConsentStrings = {
    title: string;
    text: string;
    accept: string;
    decline: string;
    close: string;
    more: string;
    gpc: string;
};
const STRINGS: Record<string, ConsentStrings> = {
    en: {
        title: 'Privacy choices',
        text: 'We use optional audience-measurement cookies to understand how this site is used. You can allow or block them and change your choice later.',
        accept: 'Allow',
        decline: 'Block',
        close: 'Close',
        more: 'Details',
        gpc: 'Your browser is sending a Global Privacy Control signal, so audience measurement is blocked.',
    },
    fr: {
        title: 'Choix de confidentialité',
        text: 'Nous utilisons des cookies facultatifs de mesure d’audience pour comprendre l’utilisation de ce site. Vous pouvez les autoriser ou les bloquer et modifier votre choix plus tard.',
        accept: 'Autoriser',
        decline: 'Bloquer',
        close: 'Fermer',
        more: 'Détails',
        gpc: 'Votre navigateur envoie un signal Global Privacy Control ; la mesure d’audience est donc bloquée.',
    },
    'fr-ch': {
        title: 'Choix de confidentialité',
        text: 'Nous utilisons des cookies facultatifs de mesure d’audience pour comprendre l’utilisation de ce site. Vous pouvez les autoriser ou les bloquer et modifier votre choix plus tard.',
        accept: 'Autoriser',
        decline: 'Bloquer',
        close: 'Fermer',
        more: 'Détails',
        gpc: 'Votre navigateur envoie un signal Global Privacy Control ; la mesure d’audience est donc bloquée.',
    },
    de: {
        title: 'Datenschutzeinstellungen',
        text: 'Wir verwenden optionale Cookies zur Reichweitenmessung, um die Nutzung dieser Website zu verstehen. Sie können sie zulassen oder blockieren und Ihre Auswahl später ändern.',
        accept: 'Zulassen',
        decline: 'Blockieren',
        close: 'Schließen',
        more: 'Details',
        gpc: 'Ihr Browser sendet ein Global-Privacy-Control-Signal. Die Reichweitenmessung ist daher blockiert.',
    },
    nl: {
        title: 'Privacykeuzes',
        text: 'We gebruiken optionele cookies voor publieksmeting om te begrijpen hoe deze site wordt gebruikt. U kunt ze toestaan of blokkeren en uw keuze later wijzigen.',
        accept: 'Toestaan',
        decline: 'Blokkeren',
        close: 'Sluiten',
        more: 'Details',
        gpc: 'Uw browser verzendt een Global Privacy Control-signaal. Publieksmeting is daarom geblokkeerd.',
    },
    it: {
        title: 'Scelte sulla privacy',
        text: 'Utilizziamo cookie facoltativi per la misurazione dell’audience per capire come viene usato questo sito. Puoi consentirli o bloccarli e modificare la scelta in seguito.',
        accept: 'Consenti',
        decline: 'Blocca',
        close: 'Chiudi',
        more: 'Dettagli',
        gpc: 'Il browser invia un segnale Global Privacy Control, quindi la misurazione dell’audience è bloccata.',
    },
};
const baseStrings = STRINGS[locale] ?? STRINGS[locale.split('-')[0]] ?? STRINGS.en;
const s = locale === 'de-ch' ? toSwissGerman(baseStrings) : baseStrings;
const privacyHref = locale === 'fr' || locale === 'fr-ch' ? '/privacy/#cookies-fr' : '/privacy/#cookies';
const fixedChoicesOnDesktop = [
    '/signin',
    '/signup',
    '/docs',
    '/not-found',
    '/forgot-password',
].some((route) => Astro.url.pathname.includes(route));
---

<button
    id="bsk-privacy-choices-mobile"
    hidden
    type="button"
    class:list={[
        'fixed bottom-3 left-3 z-[60] cursor-pointer rounded-md border border-secondary/15 bg-white px-3 py-2 text-xs font-semibold text-foreground shadow-md',
        { 'md:hidden': !fixedChoicesOnDesktop },
    ]}
>
    {s.title}
</button>

<div
    id="bsk-consent"
    hidden
    role="dialog"
    aria-labelledby="bsk-consent-title"
    aria-describedby="bsk-consent-copy"
    class="fixed bottom-4 left-4 z-[70] max-w-[360px] rounded-lg border border-secondary/15 bg-white p-4 text-sm text-foreground shadow-xl"
>
    <div class="mb-2 flex items-start justify-between gap-4">
        <h2 id="bsk-consent-title" class="font-semibold">{s.title}</h2>
        <button id="bsk-consent-close" type="button" class="cursor-pointer text-muted-foreground hover:text-foreground" aria-label={s.close}>×</button>
    </div>
    <p id="bsk-consent-copy" class="mb-3 leading-snug">
        {s.text} <a href={privacyHref} class="text-cyan-700 underline hover:text-secondary">{s.more}</a>
    </p>
    <p id="bsk-consent-gpc" hidden class="mb-3 rounded-md bg-secondary/5 p-2 leading-snug">{s.gpc}</p>
    <div class="flex gap-2">
        <button id="bsk-consent-accept" type="button" class="flex-1 cursor-pointer rounded-md border border-secondary/20 px-3 py-1.5 font-semibold transition-colors hover:bg-secondary/5">{s.accept}</button>
        <button id="bsk-consent-decline" type="button" class="flex-1 cursor-pointer rounded-md border border-secondary/20 px-3 py-1.5 font-semibold transition-colors hover:bg-secondary/5">{s.decline}</button>
    </div>
</div>

<script is:inline>
(function () {
    var box = document.getElementById('bsk-consent');
    var accept = document.getElementById('bsk-consent-accept');
    var decline = document.getElementById('bsk-consent-decline');
    var close = document.getElementById('bsk-consent-close');
    var gpcNote = document.getElementById('bsk-consent-gpc');
    var mobileChoices = document.getElementById('bsk-privacy-choices-mobile');
    if (!box || !accept || !decline || !close || !mobileChoices) return;

    function hasGpc() {
        return navigator.globalPrivacyControl === true;
    }

    function syncGpc() {
        var blocked = hasGpc();
        accept.disabled = blocked;
        accept.setAttribute('aria-disabled', blocked ? 'true' : 'false');
        accept.classList.toggle('cursor-not-allowed', blocked);
        accept.classList.toggle('opacity-50', blocked);
        if (gpcNote) gpcNote.hidden = !blocked;
    }

    function show() {
        syncGpc();
        mobileChoices.hidden = true;
        box.hidden = false;
    }

    function hide() {
        box.hidden = true;
        mobileChoices.hidden = false;
    }

    function choose(value) {
        if (value === 'granted' && hasGpc()) value = 'denied';
        try {
            localStorage.setItem('biosked-consent', JSON.stringify({ v: value, t: Date.now() }));
        } catch (e) {}
        hide();
        window.__bskConsentPending = false;
        if (value === 'granted') {
            if (window.__bskLoadGA) window.__bskLoadGA();
        } else if (window.__bskDisableGA) {
            window.__bskDisableGA();
        }
    }

    accept.addEventListener('click', function () { choose('granted'); });
    decline.addEventListener('click', function () { choose('denied'); });
    close.addEventListener('click', hide);
    mobileChoices.addEventListener('click', show);
    window.addEventListener('bsk:open-privacy-choices', show);
    window.addEventListener('bsk:consent-synced', function (event) {
        if (event.detail && event.detail.pending) show();
        else hide();
    });
    if (window.__bskConsentPending) show();
    else hide();
})();
</script>
