---
// The JFR 2026 flyer vignette, rebuilt for the web: a published Momentum
// schedule opens a Doctolib agenda. Names are fictitious. Sizes are in em, so
// the whole drawing scales with the font size set on the root.
import './tokens.css';

interface Props {
  class?: string;
  label?: string;
}

const {
  class: className = '',
  label = 'Illustration : le planning publié dans Momentum ouvre l’agenda Doctolib du Dr J. Moreau, IRM salle 2, avec ses créneaux de rendez-vous.',
} = Astro.props;
const creneaux = ['08:00', '08:20', '08:40', '09:00', '09:20', '09:40', '10:00', '10:20', '10:40', '11:00'];
---

<div class:list={['mmdl dv', className]} role="img" aria-label={label} data-dv>
  <div class="dv-panneau" aria-hidden="true">
    <div class="dv-barre">
      <img src="/images/partners/momentum-logo.svg" alt="" width="91" height="12" class="dv-mm mmdl-logo-blanc" />
      <span class="dv-libelle">Planning des équipes</span>
      <span class="dv-publier"><span class="dv-txt"><span class="dv-a-publier">Publier</span><span class="dv-publie">Publié</span></span></span>
    </div>
    <div class="dv-tete"><span></span><span>Matin</span><span>Après-midi</span></div>
    <div class="dv-ligne">
      <span class="dv-nom"><i>CL</i>Dr C. Lefèvre</span>
      <span class="dv-puce scan">Scanner</span>
      <span class="dv-puce mammo">Mammo</span>
    </div>
    <div class="dv-ligne">
      <span class="dv-nom"><i>JM</i>Dr J. Moreau</span>
      <span class="dv-puce irm cible">IRM · salle 2<span class="dv-fleche"></span></span>
      <span class="dv-puce irm">IRM · salle 1</span>
    </div>
  </div>

  <div class="dv-carte" aria-hidden="true">
    <div class="dv-carte-tete">
      <img src="/images/partners/doctolib-logo.svg" alt="" width="160" height="40" class="dv-dl" />
      <span class="dv-libelle dv-libelle-dl">Agenda des patients</span>
    </div>
    <div class="dv-sujet">Dr J. Moreau · IRM salle 2</div>
    <div class="dv-creneaux">
      {creneaux.map((h, i) => <span style={`--i:${i}`}>{h}</span>)}
    </div>
  </div>
</div>

<script is:inline>
  // Arm the animation before first paint; without JS or with reduced motion,
  // the drawing simply shows its final state.
  (function () {
    var all = document.querySelectorAll('[data-dv]:not([data-dv-armed])');
    var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    all.forEach(function (el) {
      el.setAttribute('data-dv-armed', '');
      if (still || !('IntersectionObserver' in window)) return;
      el.classList.add('dv-attente');
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          el.classList.remove('dv-attente');
          el.classList.add('dv-joue');
          io.disconnect();
        });
      }, { threshold: 0.35 });
      io.observe(el);
    });
  })();
</script>

<style>
  .dv {
    position: relative;
    width: 100%;
    max-width: 36em;
    margin-inline: auto;
    font-size: clamp(11px, 2.8vw, 15px);
    font-feature-settings: 'cv11' 1;
    padding-bottom: 0.2em;
  }

  /* Momentum panel */
  .dv-panneau {
    width: 88%;
    background: var(--nuit-2);
    border: 1px solid var(--trait);
    border-radius: 0.6em;
    padding-bottom: 0.45em;
    box-shadow: 0 1.4em 3em -1em rgb(0 0 0 / 0.45);
  }
  .dv-barre {
    display: flex;
    align-items: center;
    gap: 0.8em;
    height: 2.9em;
    padding: 0 1em;
    border-bottom: 1px solid var(--trait);
    font-size: 1em;
  }
  .dv-mm {
    height: 0.95em;
    width: auto;
  }
  .dv-publier {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    height: 1.75em;
    padding: 0 0.8em;
    border-radius: 0.4em;
    background: var(--cyan);
    color: var(--nuit);
    font-weight: 700;
    font-size: 0.88em;
  }
  .dv-publier {
    margin-left: auto;
  }
  .dv-txt {
    display: inline-grid;
  }
  .dv-txt > span {
    grid-area: 1 / 1;
  }
  .dv-a-publier {
    opacity: 0;
  }
  .dv-publie::after {
    content: ' ✓';
  }

  .dv-tete,
  .dv-ligne {
    display: grid;
    grid-template-columns: 31% 1fr 1fr;
    align-items: center;
    padding: 0 1em;
  }
  .dv-tete {
    height: 2em;
    font-size: 0.82em;
    color: var(--gris-clair);
    border-bottom: 1px solid var(--trait);
  }
  .dv-tete span {
    padding-left: 0.5em;
  }
  .dv-ligne {
    height: 2.95em;
    border-bottom: 1px dashed #262e63;
    font-size: 0.95em;
  }
  .dv-ligne:last-child {
    border-bottom: 0;
  }
  .dv-nom {
    display: flex;
    align-items: center;
    gap: 0.55em;
    color: #e6eaf5;
    font-weight: 500;
    white-space: nowrap;
  }
  .dv-nom i {
    font-style: normal;
    display: inline-grid;
    place-items: center;
    width: 1.6em;
    height: 1.6em;
    border-radius: 50%;
    background: #2a3474;
    color: #c9d0e6;
    font-size: 0.72em;
    font-weight: 600;
  }
  .dv-puce {
    position: relative;
    display: flex;
    align-items: center;
    height: 1.85em;
    margin: 0 0.35em;
    padding: 0 0.6em;
    border-radius: 0.35em;
    font-weight: 600;
    font-size: 0.92em;
    color: var(--nuit);
    white-space: nowrap;
  }
  .dv-puce.irm { background: var(--irm); }
  .dv-puce.scan { background: var(--scan); }
  .dv-puce.echo { background: var(--echo); color: #fff; }
  .dv-puce.mammo { background: var(--mammo); }
  .dv-puce.vide {
    background: repeating-linear-gradient(135deg, var(--nuit-3) 0 0.25em, var(--nuit-2) 0.25em 0.55em);
    color: var(--gris-clair);
    font-weight: 500;
  }
  .dv-puce.cible {
    outline: 2px solid var(--cyan);
    outline-offset: 0.2em;
  }
  /* Arrow from the targeted vacation down into the Doctolib card. */
  .dv-fleche {
    position: absolute;
    left: 50%;
    top: calc(100% + 0.45em);
    height: 3.05em;
    border-left: 2px solid var(--cyan);
    transform: translateX(-1px);
    transform-origin: top;
  }
  .dv-fleche::after {
    content: '';
    position: absolute;
    left: -0.42em;
    bottom: -0.55em;
    border-left: 0.36em solid transparent;
    border-right: 0.36em solid transparent;
    border-top: 0.6em solid var(--cyan);
    margin-left: -1px;
  }

  /* Doctolib card */
  .dv-carte {
    position: relative;
    z-index: 2;
    width: 68%;
    margin: 3.1em 0 0 auto;
    background: #fff;
    color: var(--encre);
    border-radius: 0.6em;
    padding: 1em 1.1em 1.1em;
    box-shadow: 0 0.4em 1.6em rgb(0 0 0 / 0.35);
  }
  .dv-carte-tete {
    display: flex;
    align-items: center;
    gap: 0.7em;
    margin-bottom: 0.75em;
  }
  .dv-dl {
    display: block;
    height: 1.15em;
    width: auto;
  }
  .dv-libelle {
    font-size: 0.88em;
    font-weight: 500;
    color: var(--gris-clair);
    white-space: nowrap;
  }
  .dv-libelle-dl {
    color: var(--gris);
  }
  .dv-sujet {
    font-weight: 600;
    font-size: 1.02em;
    line-height: 1.25;
  }
  .dv-creneaux {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.4em;
    margin-top: 0.85em;
  }
  .dv-creneaux span {
    display: grid;
    place-items: center;
    height: 1.6em;
    border-radius: 0.3em;
    font-size: 0.85em;
    font-weight: 600;
    color: var(--doctolib);
    background: var(--doctolib-voile);
    font-variant-numeric: tabular-nums;
  }

  .dv-publier,
  .dv-txt > span {
    white-space: nowrap;
  }

  /* Narrow phones: the panel takes the full width and drops the initials. */
  @media (max-width: 480px) {
    .dv-panneau {
      width: 100%;
    }
    .dv-barre {
      padding: 0 0.8em;
      gap: 0.6em;
    }
    .dv-tete,
    .dv-ligne {
      grid-template-columns: 32% 1fr 1fr;
      padding: 0 0.8em;
    }
    .dv-nom i {
      display: none;
    }
    .dv-puce {
      margin: 0 0.2em;
      padding: 0 0.45em;
    }
    .dv-carte {
      width: 82%;
    }
  }

  /* Animation: publish, arrow, agenda, slots. Armed by the inline script. */
  .dv.dv-attente .dv-fleche { transform: translateX(-1px) scaleY(0); }
  .dv.dv-attente .dv-fleche::after,
  .dv.dv-attente .dv-carte,
  .dv.dv-attente .dv-creneaux span { opacity: 0; }
  .dv.dv-attente .dv-puce.cible { outline-color: transparent; }
  .dv.dv-attente .dv-a-publier { opacity: 1; }
  .dv.dv-attente .dv-publie { opacity: 0; }

  .dv.dv-joue .dv-publier { animation: dv-clic 0.5s ease-out 0.25s both; }
  .dv.dv-joue .dv-puce.cible { animation: dv-cible 0.45s ease-out 0.6s both; }
  .dv.dv-joue .dv-fleche { animation: dv-trait 0.45s ease-in-out 0.85s both; }
  .dv.dv-joue .dv-fleche::after { animation: dv-fondu 0.2s ease-out 1.2s both; }
  .dv.dv-joue .dv-carte { animation: dv-monte 0.55s cubic-bezier(0.2, 0.8, 0.2, 1) 1.25s both; }
  .dv.dv-joue .dv-creneaux span { animation: dv-fondu 0.3s ease-out calc(1.65s + var(--i) * 0.06s) both; }
  .dv.dv-joue .dv-a-publier { animation: dv-cache 0.15s linear 0.55s both; }
  .dv.dv-joue .dv-publie { animation: dv-fondu 0.15s linear 0.6s both; }

  @keyframes dv-clic {
    0% { transform: scale(1); box-shadow: 0 0 0 0 rgb(108 229 232 / 0.6); }
    40% { transform: scale(0.94); }
    100% { transform: scale(1); box-shadow: 0 0 0 0.7em rgb(108 229 232 / 0); }
  }
  @keyframes dv-cible {
    from { outline-color: transparent; }
    to { outline-color: var(--cyan); }
  }
  @keyframes dv-trait {
    from { transform: translateX(-1px) scaleY(0); }
    to { transform: translateX(-1px) scaleY(1); }
  }
  @keyframes dv-fondu {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes dv-cache {
    from { opacity: 1; }
    to { opacity: 0; }
  }
  @keyframes dv-monte {
    from { opacity: 0; transform: translateY(0.8em); }
    to { opacity: 1; transform: none; }
  }
</style>
