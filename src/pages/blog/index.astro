---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";

import { Image } from 'astro:assets';
import { blogFeed } from '@/data/blogFeed';
import { LOCALE_LABELS, ONCALL_GUIDE } from '@/i18n/locales';
import OncallGuideCard from '@/components/sections/OncallGuideCard.astro';

// Newest first; includes scheduled posts once their date has come
const posts = await blogFeed('en');

const dateOptions: Intl.DateTimeFormatOptions = {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
};

// const allPosts = Object.values(
//   Astro.currentLocale === 'fr' 
//     ? import.meta.glob('./posts/fr/*.md', { eager: true })
//     : import.meta.glob('./posts/*.md', { eager: true })
// );

// Visitors from the de, de-ch, nl and it sites land on this blog: point them to the guide in their language.
const guideLocales = (['de', 'de-ch', 'fr', 'fr-ch', 'it', 'nl'] as const).map((code) => ({ code, label: LOCALE_LABELS[code], href: `${ONCALL_GUIDE[code]}/` }));
const isGuide = (href: string) => href === `${ONCALL_GUIDE.en}/`;

const lastPost = posts[0];
if (!lastPost) throw new Error('The English blog collection is empty.');
---

<BaseLayout
    title="Blogs | BioSked & Momentum | Healthcare Scheduling Innovation"
    description="Articles from BioSked on physician and medical team scheduling: on-call fairness, RVU-based scheduling, radiology and emergency department rosters, and Momentum product news."
>
    <div class="container max-w-5xl section-padding mb-30">
        <h1 class="text-display-section mb-3">Blog</h1>
        <p class="text-muted-foreground max-w-2xl mb-8">
            Physician and medical team scheduling: on-call fairness, rosters by specialty, and Momentum news.
        </p>

        <OncallGuideCard
            title="Free physician call schedule template"
            text="Excel template with fairness counters, and a six-step guide."
            cta={{ label: 'Get the template', href: `${ONCALL_GUIDE.en}/` }}
            image="/guides/og/en-call-schedule.jpg"
            imageAlt="Preview of the Excel call schedule template: schedule, checks and fairness counters per physician"
            alternatesLabel="Other countries"
            alternates={guideLocales}
        />

        <div class="border rounded mb-20 bg-white/20 hover:bg-white/35 transition-all shadow-xl shadow-secondary/5">
            <a href={lastPost.href} class="md:flex md:grid-cols-2 group">
                <div class:list={['flex-3', isGuide(lastPost.href) && 'biosked-branded-visual']}><Image src={lastPost.image} alt={lastPost.title} class="rounded-sm md:opacity-90 group-hover:opacity-100 transition-all ease-out duration-300"/></div>
                <div class="flex-2 p-5 md:pl-9 sm:pr-6 sm:pt-7">
                    <span class="text-muted-foreground text-sm">{lastPost.author ? `${lastPost.author} · ` : ''}{lastPost.date.toLocaleDateString('en-US', dateOptions)}</span>
                    <span class="opacity-0 group-hover:opacity-100 transition-opacity ease-out duration-500 text-cyan-500 font-medium tracking-large text-sm ml-2 hidden lg:inline">READ</span>
                    <h2 class="text-display-card my-3">{lastPost.title}</h2>
                    <div class="text-muted-foreground text-sm">{lastPost.description}</div>
                </div>     
            </a>
        </div>
        
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-y-20">
            {posts.slice(1).map((post, index) => 
                <a href={post.href} class="group">
                    <li class={index%2 ? 'md:pl-12 border-none' :'md:pr-12 group relative md:border-r md:border-secondary/10'}>
                        {isGuide(post.href) ? (
                            <div class="biosked-branded-visual mb-4 md:mb-5">
                                <Image src={post.image} alt={post.title} class="rounded-sm shadow-lg shadow-secondary/10 md:opacity-90 group-hover:opacity-100 transition-all ease-out duration-300"/>
                            </div>
                        ) : (
                            <Image src={post.image} alt={post.title} class="rounded-sm mb-4 md:mb-5 shadow-lg shadow-secondary/10 md:opacity-90 group-hover:opacity-100 transition-all ease-out duration-300"/>
                        )}
                        <span class="text-muted-foreground text-sm">{post.author ? `${post.author} · ` : ''}{post.date.toLocaleDateString('en-US', dateOptions)}</span>
                        <span class="opacity-0 group-hover:opacity-100 transition-opacity ease-out duration-500 text-cyan-500 font-medium tracking-large text-sm ml-2">READ</span>
                        <h2 class="text-display-card my-3">{post.title}</h2>
                        <div class="text-muted-foreground text-sm">{post.description}</div>
                    </li>
                </a>
            )}
        </ul>
    </div>
</BaseLayout>
