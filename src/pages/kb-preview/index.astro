---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { kbCopy, kbHomePath, languageLinks } from '@/lib/kb';

const links = languageLinks('en');
---

<BaseLayout
  title="BioSked Momentum Knowledge Base Preview"
  description={kbCopy.en.chooseLanguage}
  locale="en"
  languageLinks={links}
  noIndex={true}
  pageType="kb-preview"
>
  <section class="relative overflow-hidden bg-[#edf9f8] py-20 md:py-28">
    <div class="pointer-events-none absolute -right-28 -top-36 size-[30rem] rounded-full bg-[#35c7c9]/10 blur-3xl"></div>
    <div class="container relative max-w-3xl text-center">
      <span class="inline-flex rounded-full bg-[#173f56] px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] text-white">Preview</span>
      <p class="mt-5 text-xs font-bold uppercase tracking-[0.2em] text-[#0f6f76]">BioSked Support</p>
      <h1 class="mt-3 font-heading text-4xl font-semibold tracking-[-0.035em] text-[#102f46] md:text-6xl">Momentum Knowledge Base</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-slate-600">Choose your knowledge base language. The existing HubSpot knowledge base remains untouched and available for immediate rollback.</p>
      <div class="mx-auto mt-10 grid max-w-xl gap-4 sm:grid-cols-2">
        <a href={kbHomePath('en')} class="group rounded-2xl border border-slate-200 bg-white p-7 text-left shadow-[0_18px_45px_-34px_rgba(15,54,71,0.55)] transition hover:-translate-y-0.5 hover:border-[#70d2d2]">
          <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#0f6f76]">English</span>
          <strong class="mt-2 block font-heading text-xl text-[#102f46]">Knowledge Base</strong>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[#137b83]">Open <span class="transition-transform group-hover:translate-x-1">→</span></span>
        </a>
        <a href={kbHomePath('fr')} class="group rounded-2xl border border-slate-200 bg-white p-7 text-left shadow-[0_18px_45px_-34px_rgba(15,54,71,0.55)] transition hover:-translate-y-0.5 hover:border-[#70d2d2]">
          <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#0f6f76]">Français</span>
          <strong class="mt-2 block font-heading text-xl text-[#102f46]">Base de connaissances</strong>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[#137b83]">Ouvrir <span class="transition-transform group-hover:translate-x-1">→</span></span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
