---
import type { KbLocale } from '@/lib/kb';
import { kbCopy } from '@/lib/kb';

interface Props {
  locale: KbLocale;
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const copy = kbCopy[locale];
const searchId = `kb-search-${locale}-${compact ? 'compact' : 'full'}`;
const resultsId = `${searchId}-results`;
---

<div class:list={['kb-search relative mx-auto w-full', compact ? 'max-w-2xl' : 'max-w-3xl']} data-kb-search data-locale={locale} data-index-url="/kb-preview/search-index.json">
  <form role="search" class="relative" data-kb-search-form>
    <label for={searchId} class="sr-only" data-kb-search-label>{copy.searchLabel}</label>
    <svg aria-hidden="true" class="pointer-events-none absolute left-5 top-1/2 size-5 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.8-3.8"></path>
    </svg>
    <input
      id={searchId}
      type="search"
      role="combobox"
      autocomplete="off"
      spellcheck="false"
      placeholder={copy.searchPlaceholder}
      aria-label={copy.searchLabel}
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls={resultsId}
      class:list={[
        'w-full border border-slate-200 bg-white pl-14 pr-5 text-slate-900 shadow-[0_18px_45px_-25px_rgba(15,54,71,0.45)] outline-none transition placeholder:text-slate-400 focus:border-[#35c7c9] focus:ring-4 focus:ring-[#35c7c9]/15',
        compact ? 'h-13 rounded-xl text-base' : 'h-16 rounded-2xl text-lg',
      ]}
      data-kb-search-input
    />
  </form>
  <p class="sr-only" aria-live="polite" data-kb-search-status>{copy.searchHint}</p>
  <!--
    popover="manual" renders the result list in the browser's top layer, so it can
    never be clipped by an ancestor's overflow (the hero section, the layout's
    overflow-x-clip main, or the scrolling body all used to cut it off).
    Positioning is computed from the input rect; the absolute/z-40 classes remain
    as the fallback for browsers without popover support.
  -->
  <div
    id={resultsId}
    role="listbox"
    popover="manual"
    class="kb-search-results absolute inset-x-0 top-full z-40 mt-2 hidden max-h-[28rem] overflow-y-auto rounded-2xl border border-slate-200 bg-white p-2 text-left shadow-2xl"
    data-kb-search-results
  ></div>
  <template data-kb-search-copy data-no-results={copy.noResults} data-open-article={copy.openArticle}></template>
</div>

<style>
  /* Neutralise the UA popover defaults (centred, auto margins, own border/padding)
     so the list keeps the design-system look while living in the top layer. */
  .kb-search-results:popover-open {
    position: fixed;
    margin: 0;
    inset: auto;
    overflow-y: auto;
    border-width: 1px;
  }
</style>

<script is:inline>
  const normalizeKbSearch = (value) => String(value || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();

  const getKbIndex = (url) => {
    if (!window.__bskKbSearchIndex) {
      window.__bskKbSearchIndex = fetch(url, { headers: { Accept: 'application/json' } }).then((response) => {
        if (!response.ok) throw new Error(`Knowledge base search failed: ${response.status}`);
        return response.json();
      });
    }
    return window.__bskKbSearchIndex;
  };

  const initKbSearch = (root) => {
    if (root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    const locale = root.dataset.locale;
    const indexUrl = root.dataset.indexUrl;
    const form = root.querySelector('[data-kb-search-form]');
    const input = root.querySelector('[data-kb-search-input]');
    const results = root.querySelector('[data-kb-search-results]');
    const status = root.querySelector('[data-kb-search-status]');
    const copy = root.querySelector('[data-kb-search-copy]');
    let matches = [];
    let activeIndex = -1;
    const canPopover = typeof results.showPopover === 'function' && typeof HTMLElement !== 'undefined'
      && HTMLElement.prototype.hasOwnProperty('popover');

    // Anchor the top-layer list to the input and keep it inside the viewport.
    const position = () => {
      if (!canPopover) return;
      const rect = input.getBoundingClientRect();
      const gap = 8;
      const below = window.innerHeight - rect.bottom - gap - 12;
      const above = rect.top - gap - 12;
      // Keep the list below the input (expected behaviour) and only flip when the
      // space there is genuinely cramped and there is clearly more room above.
      const flip = below < 240 && above > below + 60;
      const space = Math.max(180, Math.min(448, flip ? above : below));
      results.style.left = `${Math.round(rect.left)}px`;
      results.style.width = `${Math.round(rect.width)}px`;
      results.style.maxHeight = `${Math.round(space)}px`;
      if (flip) {
        results.style.top = 'auto';
        results.style.bottom = `${Math.round(window.innerHeight - rect.top + gap)}px`;
      } else {
        results.style.bottom = 'auto';
        results.style.top = `${Math.round(rect.bottom + gap)}px`;
      }
    };

    const open = () => {
      if (canPopover) {
        if (!results.matches(':popover-open')) results.showPopover();
        position();
      }
      results.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
    };

    const close = () => {
      if (canPopover && results.matches(':popover-open')) results.hidePopover();
      results.classList.add('hidden');
      input.setAttribute('aria-expanded', 'false');
      activeIndex = -1;
    };

    window.addEventListener('resize', () => { if (!results.classList.contains('hidden')) position(); });
    window.addEventListener('scroll', () => { if (!results.classList.contains('hidden')) position(); }, true);

    const setActive = (nextIndex) => {
      const links = [...results.querySelectorAll('a')];
      if (!links.length) return;
      activeIndex = (nextIndex + links.length) % links.length;
      links.forEach((link, index) => {
        link.setAttribute('aria-selected', index === activeIndex ? 'true' : 'false');
        link.classList.toggle('bg-[#eaf9f9]', index === activeIndex);
      });
      links[activeIndex].focus();
    };

    const render = (items) => {
      results.replaceChildren();
      matches = items;
      activeIndex = -1;
      if (!items.length) {
        const empty = document.createElement('p');
        empty.className = 'px-4 py-5 text-sm text-slate-500';
        empty.textContent = copy.dataset.noResults;
        results.append(empty);
        status.textContent = copy.dataset.noResults;
      } else {
        const list = document.createElement('div');
        items.forEach((item) => {
          const link = document.createElement('a');
          link.href = item.path;
          link.setAttribute('role', 'option');
          link.setAttribute('aria-selected', 'false');
          link.className = 'block rounded-xl px-4 py-3 transition hover:bg-[#eaf9f9] focus:bg-[#eaf9f9] focus:outline-none';
          const title = document.createElement('span');
          title.className = 'block font-semibold text-[#102f46]';
          title.textContent = item.title;
          const meta = document.createElement('span');
          meta.className = 'mt-0.5 block text-sm text-slate-500';
          meta.textContent = [item.category, item.subcategory].filter(Boolean).join(' · ');
          link.append(title, meta);
          list.append(link);
        });
        results.append(list);
        status.textContent = `${items.length} result${items.length === 1 ? '' : 's'}`;
      }
      open();
    };

    const search = async () => {
      const query = normalizeKbSearch(input.value);
      if (query.length < 2) {
        close();
        status.textContent = '';
        return;
      }
      try {
        const index = await getKbIndex(indexUrl);
        const terms = query.split(' ');
        const scored = index
          .filter((item) => item.locale === locale)
          .map((item) => {
            const title = normalizeKbSearch(item.title);
            const category = normalizeKbSearch(`${item.category || ''} ${item.subcategory || ''}`);
            const body = normalizeKbSearch(`${item.description || ''} ${item.searchText || ''}`);
            if (!terms.every((term) => title.includes(term) || category.includes(term) || body.includes(term))) return null;
            let score = 0;
            if (title === query) score += 100;
            if (title.startsWith(query)) score += 50;
            if (title.includes(query)) score += 25;
            if (category.includes(query)) score += 12;
            for (const term of terms) {
              if (title.includes(term)) score += 8;
              if (category.includes(term)) score += 4;
              if (body.includes(term)) score += 1;
            }
            return { ...item, score };
          })
          .filter(Boolean)
          .sort((left, right) => right.score - left.score || left.title.localeCompare(right.title, locale))
          .slice(0, 8);
        render(scored);
      } catch (error) {
        console.error(error);
        render([]);
      }
    };

    let timer;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(search, 90);
    });
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        close();
        input.blur();
      } else if (event.key === 'ArrowDown' && matches.length) {
        event.preventDefault();
        setActive(activeIndex + 1);
      } else if (event.key === 'ArrowUp' && matches.length) {
        event.preventDefault();
        setActive(activeIndex - 1);
      }
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const first = results.querySelector('a');
      if (first) window.location.assign(first.href);
    });
    document.addEventListener('click', (event) => {
      if (!root.contains(event.target)) close();
    });
  };

  document.querySelectorAll('[data-kb-search]').forEach(initKbSearch);
</script>
