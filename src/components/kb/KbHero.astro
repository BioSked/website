---
import KbSearch from './KbSearch.astro';
import { kbCopy, kbSupportPath, type KbLocale } from '@/lib/kb';

interface Props {
  locale: KbLocale;
  title?: string;
  description?: string;
  compact?: boolean;
}

const {
  locale,
  title = kbCopy[locale].siteTitle,
  description = kbCopy[locale].siteDescription,
  compact = false,
} = Astro.props;
const copy = kbCopy[locale];
---

<!--
  No overflow-hidden on the section itself: it used to clip the search results
  list. The decorative blobs are clipped by their own wrapper instead.
-->
<section class:list={['relative border-b border-[#cfe9e9] bg-[#edf9f8]', compact ? 'py-9 md:py-12' : 'py-12 md:py-18']}>
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -right-28 -top-32 size-96 rounded-full bg-[#39c6c8]/10 blur-2xl"></div>
    <div class="absolute -bottom-40 -left-24 size-80 rounded-full bg-[#173f56]/5 blur-3xl"></div>
  </div>
  <div class="container relative max-w-5xl text-center">
    <h1 class:list={['mx-auto max-w-4xl font-heading font-semibold tracking-[-0.035em] text-[#102f46]', compact ? 'text-3xl md:text-4xl' : 'text-4xl md:text-6xl']}>
      {title}
    </h1>
    <p class:list={['mx-auto mt-4 max-w-2xl leading-relaxed text-slate-600', compact ? 'text-base' : 'text-lg']}>
      {description}
    </p>
    <div class="mt-8">
      <KbSearch locale={locale} compact={compact} />
    </div>
    {!compact && (
      <a href={kbSupportPath(locale)} class="mt-5 inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold text-[#13596a] transition hover:bg-white/70 hover:text-[#102f46]">
        {copy.support}
        <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
</section>
